#: ../../source/involved/style_guide.rst:243
msgid "Before submitting a pull request, verify:"
msgstr "Перед отправкой pull request проверьте:"

#: ../../source/involved/style_guide.rst:245
msgid "[ ] The document begins with a unique anchor"
msgstr "[ ] Документ начинается с уникального якоря"

#: ../../source/involved/style_guide.rst:246
msgid "[ ] Correct headers are used (===, ---, ~~~)"
msgstr "[ ] Использованы правильные заголовки (===, ---, ~~~)"

#: ../../source/involved/style_guide.rst:247
